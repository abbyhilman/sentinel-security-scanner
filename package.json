{
  "name": "sentinel-security-scanner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,json,js,mjs}\" \"*.{json,js,mjs}\" \"templates/github-workflows/**/*.{yml,yaml,json,md}\" \"pnpm-workspace.yaml\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,json,js,mjs}\" \"*.{json,js,mjs}\" \"templates/github-workflows/**/*.{yml,yaml,json,md}\" \"pnpm-workspace.yaml\" \".github/**/*.yml\"",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm test:cli && pnpm --recursive --if-present test",
    "test:cli": "node --test tests/local-cli.test.mjs tests/local-report.test.mjs",
    "sentinel:ingest:check": "pnpm --filter @sentinel/contracts test:ingest",
    "build": "pnpm --filter @sentinel/web build",
    "build:workflow": "pnpm --filter @sentinel/web exec vite build --config ../../vite.workflow.config.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
